[global]
layer = top
padding = 16
horizontal_padding = 20

corner_radius = 10
frame_color = "#8caaee"
separator_color= frame
offset = (15,15)
width = (0,500)

font = JetbrainsMono Nerd Font 12
browser = /usr/bin/librewolf -new-tab

mouse_left_click = do_action, close_current
mouse_middle_click = close_current
mouse_right_click = close_all

show_indicators = no

[urgency_low]
background = "#3D436d"
foreground = "#d1d3ff"

[urgency_normal]
background = "#3D436d"
foreground = "#d1d3ff"

[urgency_critical]
background = "#3D436d"
foreground = "#d1d3ff"
frame_color = "#ef9f76"
